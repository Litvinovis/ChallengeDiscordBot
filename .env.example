# Пример файла с переменными окружения для Sport Challenge Bot
# Скопируйте этот файл в .env и заполните реальными значениями
# Файл .env НЕ должен попадать в git (добавлен в .gitignore)

# Discord Bot Token — получить на https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Название канала для команд бота (используется как fallback)
DISCORD_CHANNEL_NAME=качал-очка

# ID каналов Discord (приоритетный список для команд бота)
DISCORD_CHANNEL_ID_1=your_channel_id_1
DISCORD_CHANNEL_ID_2=your_channel_id_2

# ID сервера (Guild) Discord для отправки отчётов
DISCORD_REPORT_GUILD_ID=your_guild_id

# Название канала для ежедневных отчётов
DISCORD_REPORT_CHANNEL=качал-очка

# ID пользователя с правами администратора
DISCORD_ADMIN_USER_ID=your_admin_user_id

# Apache Ignite — настройки кластера
IGNITE_LOCAL_ADDRESS=127.0.0.1
IGNITE_DISCOVERY_ADDRESSES=127.0.0.1:47650..47659
IGNITE_WORK_DIR=/tmp/ignite-challenge-client
